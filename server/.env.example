# ───────────────────────────────────────────────
#  복사해서 .env 로 저장하세요:  cp .env.example .env
#  ⚠️  .env 파일은 절대 git 에 커밋하지 마세요 (.gitignore 에 이미 등록됨)
# ───────────────────────────────────────────────

PORT=4000

# ===== 거래 안전장치 (먼저 읽어주세요) =====
# 기본은 paper(모의투자). 실제 돈이 나가지 않습니다.
# 충분히 테스트한 뒤에만 live 로 바꾸세요.
TRADE_MODE=paper

# 1회 주문 최대 금액 — 실수로 큰 주문이 나가는 것을 막습니다.
MAX_ORDER_USDT=100
MAX_ORDER_KRW=100000
# 봇 1개가 하루에 실행할 수 있는 최대 매매 횟수
MAX_TRADES_PER_DAY=10

# ===== 바이낸스 =====
# 키 없이도 시세 조회·페이퍼 트레이딩은 됩니다. 잔고/실거래만 키 필요.
BINANCE_API_KEY=
BINANCE_SECRET=
# 테스트넷 권장 (https://testnet.binance.vision 에서 발급)
BINANCE_TESTNET=true

# ===== 업비트 =====
UPBIT_API_KEY=
UPBIT_SECRET=
